# Copy to .env and fill in. Never commit .env.

# --- API ---
# Shared secret for POST /process and the dashboard (send as X-Internal-Token). Use a long random string.
INTERNAL_TOKEN=change-me-to-a-long-random-string

# --- Google Sheets (service account) ---
# Service account email; share the spreadsheet with this address as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=orchestrator@your-project.iam.gserviceaccount.com
# The "private_key" from the service account JSON key, in double quotes, with \n for newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
# Spreadsheet ID: the part of the sheet URL between /d/ and /edit.
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
# Tab (worksheet) name inside the spreadsheet.
GOOGLE_SHEET_NAME=Sheet1

# --- Groq (caption generation) ---
# API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me
# Groq chat model used to write captions.
GROQ_MODEL=llama-3.3-70b-versatile
# Per-request timeout in seconds.
GROQ_TIMEOUT_SECONDS=20
# Extra attempts after a transient Groq error (429, timeout, 5xx).
GROQ_MAX_RETRIES=1

# --- Instagram Graph API ---
# Instagram Business/Creator account ID (not the username).
INSTAGRAM_ACCOUNT_ID=17841400000000000
# Page access token of the Facebook Page linked to the Instagram account.
FACEBOOK_PAGE_ACCESS_TOKEN=replace-me
# Graph API version used for all Instagram calls.
INSTAGRAM_GRAPH_API_VERSION=v25.0
# Per-request timeout in seconds.
INSTAGRAM_TIMEOUT_SECONDS=30
# Extra attempts after a transient Instagram error (429, timeout, 5xx).
INSTAGRAM_MAX_RETRIES=3

# --- Dry run ---
# true = run the full flow (sheet + Groq) but skip Instagram; posts get IDs like dry-run-xxxx.
DRY_RUN=false

# --- Rate limiting for POST /process (per client IP) ---
# Max requests per window.
API_RATE_LIMIT_MAX_REQUESTS=5
# Window length in seconds.
API_RATE_LIMIT_WINDOW_SECONDS=60

# --- Background poller ---
# Scan the sheet for pending rows automatically.
POLLING_ENABLED=true
# Seconds between scans.
POLLING_INTERVAL_SECONDS=60
# Last sheet row to scan (rows 2..POLLING_MAX_ROWS). Also bounds the dashboard.
POLLING_MAX_ROWS=100
